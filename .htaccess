# Apache configuration for InfinityFree & cPanel PHP hosting

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent direct access to includes and config directory files
    RewriteRule ^(config|includes)/.*$ - [F,L,NC]
    RewriteRule ^data/.*$ - [F,L,NC]

    # Don't rewrite real files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirect root routes if needed
    RewriteRule ^admin/?$ admin.php [L,QSA]
    RewriteRule ^goswami/?$ goswami.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# MIME Types for WebP & Modern Formats
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType audio/webm .webm
    AddType font/woff2 .woff2
</IfModule>

# GZIP Compression (Compress text, html, css, js, json, svg)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/truetype font/opentype application/vnd.ms-fontobject
</IfModule>

# Aggressive Browser Caching for Instant Page Reloads
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Media (Cache for 1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType audio/webm "access plus 1 year"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Stylesheets & Scripts
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML (validate often)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Disable Directory Browsing
Options -Indexes
